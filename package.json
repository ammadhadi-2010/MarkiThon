{
    "name": "markithon",
    "version": "1.0.0",
    "description": "MarkiThon multi-tenant marketplace and shopkeeper API",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "build": "node -e \"console.log('Static public assets are ready for Vercel.')\"",
        "deploy:check": "node -e \"require('./config/cloudEnv'); console.log('Deploy env OK')\""
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "fabric": "^5.3.0",
        "google-auth-library": "^11.1.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.11.5",
        "sequelize": "^6.37.3"
    },
    "devDependencies": {
        "nodemon": "^3.1.0"
    },
    "nodemonConfig": {
        "ignore": [
            "data/*",
            "public/*"
        ]
    }
}
